# Frontend configuration. Copy to .env.local for local development.

# Base URL of the ADG backend API. Since Phase 6A the browser does not call it directly for
# data -- every request goes through this app's own /api/adg/* proxy, which attaches the
# session's access token server-side. This value is used by the system-status page and as
# the fallback for server-side calls.
NEXT_PUBLIC_ADG_API_URL=http://localhost:8000

# Backend base URL as reachable from the web server process itself. Only needed when the web
# tier runs in a container, where localhost is the container.
# ADG_INTERNAL_API_URL=http://api:8000

# This application's own public base URL. The OIDC redirect URI is built from it
# (<ADG_WEB_URL>/api/auth/oidc/callback) and must match the identity provider's app
# registration exactly, so it is configuration rather than something inferred from a
# request's Host header. It also decides whether cookies carry the Secure attribute.
ADG_WEB_URL=http://localhost:3000

# Optional confidential-client secret for the OIDC authorization-code exchange. A public
# client using PKCE needs none. NEVER prefix this with NEXT_PUBLIC_: that would ship it to
# every browser.
# ADG_OIDC_CLIENT_SECRET=
