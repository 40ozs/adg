 "golden_scenarios": [
  {
   "id": "A",
   "title": "Modern healthy share",
   "resource": "\\\\NM-CORP-FS02\\Design",
   "groups": [
    "sg-share-design-read-only",
    "sg-share-design-write"
   ],
   "demonstrates": "A 2023 share built to the standard: two sg-share-* groups with people as direct members, inheritance unbroken, no direct user entries, no legacy groups.",
   "look_at": [
    "GET /api/v1/resources/{\\\\NM-CORP-FS02\\Design}/acl",
    "GET /api/v1/groups/{sg-share-design-write SID}/members"
   ]
  },
  {
   "id": "B",
   "title": "Legacy finance hierarchy",
   "resource": "\\\\NM-FIN-FS01\\Finance",
   "groups": [
    "Finance-RW",
    "GG_Finance_RW",
    "Finance_Read",
    "FS-Finance-R",
    "FIN-Close-Team",
    "sg-share-finance-write",
    "sg-share-finance-read-only"
   ],
   "people": [
    {
     "employee_id": "NM-00379",
     "name": "Lucia Hart",
     "email": "lucia.hart@nullmeridian.info",
     "sid": "S-1-5-21-3949361974-1583827165-633756269-1584",
     "department": "finance",
     "title": "Corporate Controller"
    }
   ],
   "demonstrates": "Four generations of finance groups on one 2017 ACL. FIN-Accounting -> Finance-Team -> Finance-RW -> GG_Finance_RW grants Modify, FIN-Close-Team grants it again, and about 40% of Finance also hold sg-share-finance-write directly: the 2024 migration added the modern groups and removed nothing. Close folders carry direct entries for named accountants.",
   "look_at": [
    "GET /api/v1/resources/{\\\\NM-FIN-FS01\\Finance}/acl",
    "GET /api/v1/access/resources/{\\\\NM-FIN-FS01\\Finance\\Accounting\\Close}/principals"
   ]
  },
  {
   "id": "C",
   "title": "Engineering sprawl",
   "resource": "\\\\NM-ENG-FS01\\Engineering",
   "groups": [
    "Share_Engineering_Modify",
    "Engineering-FS",
    "APP-GitHub-Users",
    "sg-share-engineering-write",
    "ENG-Payments",
    "Proj-Apollo",
    "PRJ_Nebula",
    "PRJ_Orion"
   ],
   "demonstrates": "The largest share: team folders, project folders, inherited access from five root entries, historical direct entries for long-tenured engineers, and an application group (APP-GitHub-Users) that became a file-share dependency. Most engineers reach Modify by three or more routes.",
   "look_at": [
    "GET /api/v1/access/resources/{\\\\NM-ENG-FS01\\Engineering\\Services\\Payments}/principals"
   ]
  },
  {
   "id": "D",
   "title": "Sensitive People share",
   "resource": "\\\\NM-HR-FS01\\People",
   "groups": [
    "HR_Share_RW",
    "HR-Confidential",
    "sg-share-people-write",
    "Hiring-Managers",
    "Payroll_Admins"
   ],
   "demonstrates": "Well controlled: Employee-Relations and Compensation are protected and limited to HR-Confidential. Two understandable exceptions: Recruiting is readable by Hiring-Managers (which nests every manager), and a Finance payroll specialist holds a direct entry on the payroll-vendor transition folder.",
   "look_at": [
    "GET /api/v1/resources/{\\\\NM-HR-FS01\\People\\Compensation}/acl"
   ]
  },
  {
   "id": "E",
   "title": "Migration and archive debt",
   "resource": "\\\\NM-ARCH-FS01\\Archive",
   "also": [
    "\\\\NM-MIG-FS01\\Migrations\\FS-Consolidation-2020"
   ],
   "groups": [
    "GG_Archive_R",
    "FS-Legacy-Users",
    "Finance-RW",
    "Proj-Zephyr-RW",
    "Project-Vega"
   ],
   "demonstrates": "Broken inheritance on every subfolder; Finance-RW granted twice on one ACL (Modify and Read & execute); Project-Vega, deleted on 2026-09-10, still named and now unresolved; home drives naming accounts deleted before ADG's first scan, an account deleted between the first and second scans, and an IT migrator's leftover Full control.",
   "look_at": [
    "GET /api/v1/resources/{\\\\NM-ARCH-FS01\\Archive\\Legacy-Home-Drives}/acl"
   ]
  },
  {
   "id": "F",
   "title": "Cross-department access, two ways",
   "resource": "\\\\NM-FIN-FS01\\Finance\\Reports\\Revenue",
   "people": [
    {
     "employee_id": "NM-00104",
     "name": "Brianna Reddy",
     "email": "brianna.reddy@nullmeridian.info",
     "sid": "S-1-5-21-3949361974-1583827165-633756269-1243",
     "department": "sales",
     "title": "Sales Operations Analyst"
    }
   ],
   "groups": [
    "Sales-Ops",
    "Revenue-Reporting",
    "Finance_Read",
    "FS-Finance-R",
    "sg-share-finance-read-only"
   ],
   "demonstrates": "Brianna Reddy moved from Finance to Sales Operations on 2022-02-01. Sales-Ops -> Revenue-Reporting grants Read & execute on the Revenue folder (and Revenue-Reporting -> Finance_Read reaches the share root); the direct Modify entry from their Finance days was never removed. ADG explains both paths, and that removing either one leaves the other standing.",
   "look_at": [
    "GET /api/v1/access/paths/principals/S-1-5-21-3949361974-1583827165-633756269-1243/resources/\\\\NM-FIN-FS01\\Finance\\Reports\\Revenue"
   ]
  },
  {
   "id": "G",
   "title": "A six-level chain",
