{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adg.local/contracts/v1/principal-observation.schema.json",
  "title": "Principal observation (v1)",
  "description": "A principal a collector resolved, or failed to resolve. An unresolvable SID is a valid observation and often a finding; it must never be dropped or given a guessed name.",
  "type": "object",
  "unevaluatedProperties": false,
  "allOf": [{ "$ref": "common.schema.json#/$defs/observationBase" }],
  "required": ["sid", "principal_kind"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "kind": { "const": "principal" },
    "run_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "observed_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "source_key": { "$ref": "common.schema.json#/$defs/sourceKey" },

    "sid": { "$ref": "common.schema.json#/$defs/sid" },
    "principal_kind": { "$ref": "common.schema.json#/$defs/principalKind" },
    "domain_sid": { "$ref": "common.schema.json#/$defs/domainSid" },
    "host_key": {
      "description": "Required for local_group: BUILTIN SIDs (S-1-5-32-*) are identical on every Windows computer, so a local group is identified by host plus SID.",
      "$ref": "common.schema.json#/$defs/hostName"
    },

    "display_name": { "type": ["string", "null"], "maxLength": 512 },
    "sam_account_name": { "type": ["string", "null"], "maxLength": 256 },
    "user_principal_name": { "type": ["string", "null"], "maxLength": 512 },
    "distinguished_name": { "type": ["string", "null"], "maxLength": 2048 },

    "group_scope": { "$ref": "common.schema.json#/$defs/groupScope" },
    "group_type": { "$ref": "common.schema.json#/$defs/groupType" },

    "enabled": { "type": ["boolean", "null"] },
    "is_deleted": { "type": "boolean" },

    "unresolved_reason": { "$ref": "common.schema.json#/$defs/unresolvedReason" },
    "last_known_name": {
      "description": "A name seen in an earlier scan. Display only; it must never be reported as display_name, where it would read as a current resolution.",
      "type": ["string", "null"],
      "maxLength": 512
    }
  },
  "if": { "properties": { "principal_kind": { "const": "local_group" } }, "required": ["principal_kind"] },
  "then": { "required": ["host_key"] },
  "else": {
    "if": { "properties": { "principal_kind": { "const": "unresolved" } }, "required": ["principal_kind"] },
    "then": {
      "properties": { "display_name": { "type": "null" } }
    }
  },
  "examples": [
    {
      "schema_version": "1.0",
      "kind": "principal",
      "run_id": "6f1c1a52-3f4a-4a16-9f2e-1d6b0f2a7c31",
      "observed_at": "2026-09-14T08:00:12Z",
      "source_key": "principal|S-1-5-21-1004336348-1177238915-682003330-1104",
      "sid": "S-1-5-21-1004336348-1177238915-682003330-1104",
      "principal_kind": "user",
      "display_name": "Alice Smith",
      "sam_account_name": "asmith",
      "user_principal_name": "asmith@corp.example.com",
      "enabled": true
    }
  ]
}
