    "limiting_layer": "ntfs",
    "inheritance_blocked": true,
    "boundary_resource": "\\\\FS01\\Finance\\Payroll",
    "note": "Finance-RW reaches Payroll only because it was nested into the server's BUILTIN\\Administrators, not through the parent's ACE."
