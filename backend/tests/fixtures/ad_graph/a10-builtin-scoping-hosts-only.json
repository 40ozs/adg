{
  "scenario": "a10-builtin-scoping-hosts-only",
  "title": "One BUILTIN SID on two servers and nowhere else",
  "description": "What an SMB collector produces on its own: BUILTIN\\Administrators on FS12 and on FS13, host-scoped, with no domain BUILTIN group anywhere. A bare S-1-5-32-544 now matches two stored principals and nothing else, so it is genuinely ambiguous and must be answered with both candidates rather than by picking one.",
  "expectations": {
    "distinct_group_keys": [
      "fs12|S-1-5-32-544",
      "fs13|S-1-5-32-544"
    ],
    "fs12_group_key": "fs12|S-1-5-32-544",
    "fs13_group_key": "fs13|S-1-5-32-544",
    "fs12_effective_members": [
      "S-1-5-21-2000000001-2000000002-2000000003-21011"
    ],
    "fs13_effective_members": [
      "S-1-5-21-2000000001-2000000002-2000000003-21012"
    ],
    "bare_sid_is_ambiguous": true,
    "bare_sid_candidate_count": 2,
    "note": "Resolving the bare SID must be a 409 listing both groups. This is the shape the host-scoping rule was designed for, and the contrast with a10 — where a domain BUILTIN group occupies the bare key and wins outright — is the point."
  },
