# ADG configuration template. Copy to .env and edit locally.
# NEVER commit a filled-in .env: it contains credentials.

# --- Backend ------------------------------------------------------------------
# development | test | production
ADG_ENVIRONMENT=development
ADG_LOG_LEVEL=INFO
# json | text
ADG_LOG_FORMAT=json
# PostgreSQL connection string (psycopg driver). Required in production.
ADG_DATABASE_URL=postgresql+psycopg://adg:adg_dev_password@localhost:5432/adg
ADG_DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Comma-separated browser origins allowed to call the API.
# Only needed for direct browser access; the web tier calls the API server-side.
ADG_CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Authentication -----------------------------------------------------------
# oidc | development
#
# 'development' issues its own tokens and verifies NO credential: anyone who can reach the
# API can be any account. The API refuses to start in that mode with
# ADG_ENVIRONMENT=production, so it cannot be shipped by accident.
ADG_AUTH_MODE=development

# Development mode only.
# Accounts, as comma-separated 'username:role|role:Display Name' entries. Unset for the
# default: one account per active role (viewer, auditor, admin).
# ADG_DEV_AUTH_USERS=viewer:viewer:Development Viewer,auditor:auditor,admin:admin,reviewer:reviewer,governance:governance_admin
# Signs the tokens this process issues. Leave blank to generate one per process, so that
# restarting the API invalidates every development session.
# ADG_DEV_AUTH_SECRET=
ADG_DEV_AUTH_TOKEN_LIFETIME_MINUTES=480

# OIDC / Microsoft Entra ID. Required when ADG_AUTH_MODE=oidc. Every endpoint is named
# explicitly; the API never discovers them over the network at startup.
# ADG_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# ADG_OIDC_AUDIENCE=api://adg
# ADG_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# ADG_OIDC_CLIENT_ID=<application (client) id>
# ADG_OIDC_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
# ADG_OIDC_TOKEN_ENDPOINT=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
# ADG_OIDC_SCOPES=openid profile email
# Where authorization arrives in the token. App role assignments land in 'roles'; group
# assignments land in 'groups' as object ids, which mean nothing until they are mapped.
# ADG_OIDC_ROLES_CLAIM=roles
# ADG_OIDC_GROUPS_CLAIM=groups
# ADG_OIDC_GROUP_ROLE_MAP=<group-object-id>:auditor,<group-object-id>:viewer

# Collector credentials, as comma-separated '<key id>:<secret>' pairs. Each secret must be
# at least 32 characters. Leave empty and ingestion requires an administrator's access
# token instead; ingestion is never anonymous either way.
# Generate one with:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# ADG_COLLECTOR_API_KEYS=fs01:<secret>,fs02:<secret>

# --- History retention --------------------------------------------------------
# Two switches, and the destructive one defaults to off. ADG never deletes recorded
# permission history unless both are set: the number alone is a capacity decision, and
# deleting the evidence that a permission changed has to be somebody's explicit one.
#
# 0 (the default) means every version is kept indefinitely. A non-zero window must be at
# least 30 days; anything shorter would let an ordinary audit cycle find the evidence of a
# change already gone. Nothing in the API or the collectors prunes -- it is an operator
# action, and it never removes an object's open version or its newest closed one.
ADG_HISTORY_RETENTION_DAYS=0
ADG_HISTORY_RETENTION_ENABLED=false

# --- Risk rules ---------------------------------------------------------------
#
# The eleven rules ship with the application and run by default. This names an optional
# JSON file that may re-grade their severities, move their thresholds, switch one off, and
# supply the one thing ADG cannot work out for itself: which resources are sensitive.
#
# Empty (the default) uses the shipped settings. Under those, the sensitive-resource rule
# is enabled and reports nothing, because nothing has been marked -- a configuration state
# rather than a clean result. See docs/operations/risk-rules.md and ADR-0024.
#
# A path that is set and cannot be read is a startup error, not a fall back to the
# defaults: an operator who configured a policy and mistyped the path would otherwise get a
# report produced by settings they never wrote. No secret belongs in this file.
ADG_RISK_CONFIGURATION_PATH=

# --- Alerting -----------------------------------------------------------------
#
# Which triggers are live, how loud, and where an alert goes. Empty (the default) uses the
# shipped policy: every trigger on, a fifteen-minute cooldown, critical findings only, and
# one sink that writes to the operator log. A log sink rather than none, deliberately -- an
# installation with nowhere to deliver would enqueue alerts nothing ever drains, and the
# backlog would grow behind a queue depth nobody is looking at.
#
# A path that is set and cannot be read is a startup error, not a fall back to the defaults,
# for the same reason the risk configuration gives.
#
# ** THIS FILE MAY CARRY A WEBHOOK CREDENTIAL. ** It is configuration, not source control.
# Keep it outside the repository, readable only by the API's service account. See
# docs/operations/alerting.md for the format.
ADG_ALERT_POLICY_PATH=

# Whether closing a scan run re-evaluates the risk rules and the watches inline.
#
# Off by default, and that is a cost decision rather than a doubt about the feature: turning
# it on adds an incremental evaluation, a change-feed scan per watch and a delivery attempt
# to the collector's final request, on an engine nobody has profiled against an estate with
# millions of access control entries. Measure it on yours, or drive both from a schedule:
#
#   python -m app.operations evaluate-risks
#   python -m app.operations drain-alerts --loop
#
# Being off is never silent: every completion logs a post_run line saying so, and the risk
# report says "the rules have not been evaluated" rather than showing a clean empty report.
# Either way it cannot cost the estate an observation -- the work runs after the ingestion
# transaction has committed, in its own session, and swallows its failures into a log line.
ADG_ALERTS_ON_RUN_COMPLETION=false

# --- PostgreSQL container -----------------------------------------------------
POSTGRES_USER=adg
POSTGRES_PASSWORD=adg_dev_password
POSTGRES_DB=adg
POSTGRES_PORT=5432

# --- Ports --------------------------------------------------------------------
ADG_API_PORT=8000
ADG_WEB_PORT=3000

# --- Frontend -----------------------------------------------------------------
# The browser no longer calls the API directly for data: every request goes through the web
# tier's own /api/adg/* proxy, which attaches the session token server-side. This value is
# still used by the system-status page and as the fallback for server-side calls.
NEXT_PUBLIC_ADG_API_URL=http://localhost:8000
# Backend base URL as reachable from the web server process. Only needed when the web tier
# runs in a container (docker compose sets it to http://api:8000); leave unset natively.
# ADG_INTERNAL_API_URL=http://api:8000
# The web application's own public base URL. The OIDC redirect URI is built from it
# (<ADG_WEB_URL>/api/auth/oidc/callback) and must match the app registration exactly.
ADG_WEB_URL=http://localhost:3000
# Optional confidential-client secret for the authorization-code exchange. A public client
# using PKCE needs none. NEVER prefix this with NEXT_PUBLIC_.
# ADG_OIDC_CLIENT_SECRET=

# --- Remediation (Phase 10C) ---------------------------------------------------------
#
# ADG describes permission changes and performs none of them. These three settings say what
# this deployment may do with a change plan, and the defaults say "write one, and hand it to a
# person". There is deliberately no setting that enables a real write path: shipping one is an
# adapter, a credential and a capability grant, not a configuration change. See
# docs/architecture/remediation.md section 8 and ADR-0035.

# The HMAC key that signs an exported change plan. A SECRET: configuration, never source
# control. Empty means this deployment cannot export at all -- a refusal rather than a fallback
# to an unsigned document, because an unsigned change plan is indistinguishable from one
# somebody typed and the administrator executing it has no way to tell.
#
# Rotating it changes the published key identifier (a digest prefix of this value), so a
# verifier holding the old key reports "signed with a key I do not have" rather than reporting
# tampering that did not happen. Keep the old key while any exported document is in flight.
#
ADG_REMEDIATION_SIGNING_KEY=

# Which remediator implementation this deployment gets: 'disabled' or 'lab'.
# 'disabled' is the only value a production deployment may hold, refused at startup otherwise.
# 'lab' selects a fixture-backed executor that mutates an in-memory copy of a JSON file and can
# reach nothing else -- no Windows object, no collected table, no file it was not pointed at.
# Nothing in the API constructs one; it exists so the remediator interface can be exercised.
ADG_REMEDIATION_EXECUTION_MODE=disabled

# The fixture 'lab' mode reads. Required in that mode and meaningless otherwise: a lab executor
# without one would have to invent the objects it is asked about, and would then report every
# plan as carried out.
ADG_REMEDIATION_LAB_FIXTURE_PATH=
